# Evaluation bundles are generated outputs; benchmark definitions and runner
# code live under evaluation/ and remain tracked. Keep the compact experiment
# manifest and human-readable report under source control for reproducibility;
# raw trial rows and large derived JSON artifacts remain ignored.
evaluation_results/**
!evaluation_results/**/
!evaluation_results/**/config.json
!evaluation_results/**/summary.md

# Optional OpenML cache; benchmark data must remain outside source control.
.openml_cache/
openml_cache/

# Generated policy/evaluation scratch directories.
.boundary_calibration_*/
.boundary_final_*/
.pytest_tmp_interaction*/

.ruff_cache/
.env
runs/*
!runs/.gitkeep
